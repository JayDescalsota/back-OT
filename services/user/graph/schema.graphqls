type User @key(fields: "id") {
  id: ID!
  email: String!
  name: String!
  isActive: Boolean!
  lastLogin: String
  assignments: [UserBranchAssignment!]!
}

type UserBranchAssignment {
  id: ID!
  branch: Branch!
  tenant: Tenant!
  role: Role!
  assignedBy: String!
  assignedAt: String!
  isActive: Boolean!
}

type Role @key(fields: "id") {
  id: ID!
  name: String!
  description: String
  permissions: [Permission!]!
}

type Permission @key(fields: "id") {
  id: ID!
  resource: String!
  action: String!
  scope: String!
}

type Tenant @key(fields: "id") {
  id: ID!
  name: String!
}

type Branch @key(fields: "id") {
  id: ID!
  name: String!
}

type Query {
  me: User!
  user(id: ID!): User
  myAssignments: [UserBranchAssignment!]!
}
